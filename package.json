{
  "name": "flexboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:watch": "vitest",
    "test:node": "node --env-file=.env --test tests/node/*.test.js",
    "db:migrate": "node --env-file=.env scripts/db.mjs migrate",
    "db:migrate:status": "node --env-file=.env scripts/db.mjs status",
    "db:seed": "node --env-file=.env scripts/db.mjs seed",
    "auth:provision": "node --env-file=.env scripts/provision-auth-user.mjs",
    "auth:reset-password": "node --env-file=.env scripts/reset-auth-password.mjs"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.5",
    "@vitejs/plugin-react": "4.3.4",
    "better-auth": "^1.7.14",
    "lucide-react": "latest",
    "pg": "^8.23.1",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "6.30.6",
    "vite": "6.4.5"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "30.1.3",
    "vitest": "5.0.5"
  }
}
